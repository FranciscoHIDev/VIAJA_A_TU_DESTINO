{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(facebookexternalhit|Facebot|facebot|WhatsApp|whatsapp|Twitterbot|TwitterBot|LinkedInBot|linkedinbot|TelegramBot|telegrambot|Slackbot|slackbot|Discordbot|discordbot|Pinterestbot|pinterestbot).*"
          }
        }
      ],
      "destination": "https://viaja-a-tu-destino-back.vercel.app/api/social/blog/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}